{
  "name": "amro-alnamari-exchange-erp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "DISABLE_HMR=true tsx server.ts",
    "start": "node server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:storage": "node --import tsx --test tests/storageIntegrity.test.ts",
