    "setup:financial-baseline": "node --import tsx scripts/approveFinancialBaseline.ts",
    "test:internal-transfers": "node --import tsx --test tests/internalTransfer.test.ts",
    "setup:chart-of-accounts": "node --import tsx scripts/reconcileChartOfAccounts.ts",
    "test:chart-reconciliation": "node --import tsx --test tests/chartOfAccountsMigration.test.ts",
    "test:operating-expense": "node --import tsx --test tests/operatingExpense.test.ts",
    "test:incoming-remittances": "node --import tsx --test tests/incomingRemittanceRegistration.test.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite-plugin-pwa": "^2.0.0"
  }
