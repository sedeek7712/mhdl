{
  "name": "amro-alnamari-exchange-erp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "DISABLE_HMR=true tsx server.ts",
    "start": "node server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:storage": "node --import tsx --test tests/storageIntegrity.test.ts tests/sqliteDatabase.test.ts tests/sqliteFinancialRepository.test.ts tests/sqliteDryRunMigration.test.ts tests/sqliteAuthRepository.test.ts tests/sqliteAuthMigration.test.ts tests/sqliteAuthService.test.ts tests/sqliteAuthHttp.test.ts tests/jwtSecret.test.ts tests/sqliteAuthRuntime.test.ts tests/authBackendSelection.test.ts tests/sqliteAuthServerIntegration.test.ts tests/sqliteBackupRestore.test.ts tests/dispatchRegistry.test.ts tests/authoritativeVoucher.test.ts tests/sqliteAuthRollbackExport.test.ts",
    "setup:owner": "node --import tsx scripts/bootstrapOwner.ts",
    "setup:financial-baseline": "node --import tsx scripts/approveFinancialBaseline.ts",
    "test:internal-transfers": "node --import tsx --test tests/internalTransfer.test.ts",
    "setup:chart-of-accounts": "node --import tsx scripts/reconcileChartOfAccounts.ts",
    "test:chart-reconciliation": "node --import tsx --test tests/chartOfAccountsMigration.test.ts",
    "test:operating-expense": "node --import tsx --test tests/operatingExpense.test.ts",
    "test:incoming-remittances": "node --import tsx --test tests/incomingRemittanceRegistration.test.ts",
    "test:outgoing-remittances": "node --import tsx --test tests/outgoingRemittance.test.ts",
    "test:exchange-accounting": "node --import tsx --test tests/exchangeAccounting.test.ts",
    "test:exchange-rate-registry": "node --import tsx --test tests/exchangeRateRegistry.test.ts",
    "test:server-exchange": "node --import tsx --test tests/serverExchange.test.ts",
    "test:cashier-shifts": "node --import tsx --test tests/serverCashBoxShift.test.ts",
    "test:http-integration": "node --import tsx --test tests/serverHttpIntegration.test.ts",
    "test:sqlite": "node --import tsx --test tests/sqliteDatabase.test.ts tests/sqliteFinancialRepository.test.ts tests/sqliteDryRunMigration.test.ts",
    "migrate:sqlite:dry-run": "node --import tsx scripts/sqliteDryRunMigration.ts",
    "migrate:sqlite:auth": "node --import tsx scripts/sqliteAuthMigration.ts",
    "migrate:sqlite:auth:export": "node --import tsx scripts/sqliteAuthRollbackExport.ts",
    "sqlite:backup-restore": "node --import tsx scripts/sqliteBackupRestore.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite-plugin-pwa": "^2.0.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
